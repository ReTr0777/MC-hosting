# Copy to `.env` next to docker-compose.prod.yml on the Unraid box, and fill in.
#
# This file stays on that machine and is never written by the pipeline — Jenkins only
# reads the repo. DB_PASSWORD is the deliberate exception: it comes from the Jenkins
# credential of the same name and is passed in at deploy time, so leave it out here.

# ── Database ──────────────────────────────────────────────────────────────────
# The existing Postgres server. The stack does not run one of its own; see the note
# at the top of docker-compose.prod.yml for why.
DB_HOST=192.168.50.220
DB_PORT=5432
DB_USER=mcuser
DB_NAME=mcmanager

# ── Panel ─────────────────────────────────────────────────────────────────────
# The address users actually reach the panel on. Verification and password-reset
# links are built from it; without it they fall back to the request's Host header,
# which is wrong as soon as anything sits in front of the panel.
APP_URL=https://panel.example.com
WEB_PORT=3000

JWT_SECRET=change-me
# Encrypts stored secrets (the Cloudflare API token, among others). Changing it does
# not re-encrypt them — it makes them unreadable. Set once and leave alone.
SECRET_ENCRYPTION_KEY=change-me

# ── Daemon ────────────────────────────────────────────────────────────────────
DAEMON_API_KEY=change-me
DAEMON_PORT=3500
# Mounted at /app/data in the daemon, which keeps its servers in <this>/servers and its
# config.json and frpc.toml directly inside it. Point this at the directory an existing
# node already uses — changing it does not move anything, it just hides the servers that
# are there and makes the node look freshly installed.
DAEMON_DATA=/mnt/user/appdata/craftcontrol
# Must cover every port the panel might allocate to a server, and match the range
# configured in the panel's node settings.
SERVER_PORT_RANGE=25000-25050

# ── Tunnels ───────────────────────────────────────────────────────────────────
FRP_TOKEN=change-me
TUNNEL_PORT_RANGE=25000-25050

# ── Proxy ─────────────────────────────────────────────────────────────────────
# Where players connect. Everything behind it is reached by hostname.
PROXY_PORT=25565

# ── Discord bot ───────────────────────────────────────────────────────────────
# Leave blank to run without the integration; the bot exits immediately if unset.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Must match the panel's own DISCORD_BOT_SECRET.
DISCORD_BOT_SECRET=
