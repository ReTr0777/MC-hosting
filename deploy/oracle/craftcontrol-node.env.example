# CraftControl daemon node -- configuration for run-node.sh.
#
# Install to /etc/craftcontrol/node.env, mode 600. run-node.sh reads these values
# without sourcing the file, so quoting is neither needed nor honoured: write the
# value exactly as it should reach the container, with no surrounding quotes.

# Shared secret between this node and the panel. Generate one and use the same string
# when adding the node in the panel:  openssl rand -hex 32
# The script refuses to start on a placeholder, because a wrong key looks from the
# panel exactly like the node being unreachable.
DAEMON_API_KEY=

# Host port for the daemon API. The container always listens on 3500 internally.
DAEMON_PORT=3500

# Where worlds, config.json and frpc.toml live on this host. Back this up; it is the
# only thing here that is not reproducible from the image.
DAEMON_DATA=/opt/craftcontrol/data

# The range game servers are allocated from, published on the host up front. It must
# also be open in BOTH Oracle firewalls -- see README.md. Widen it if you intend to run
# more than about fifty servers, which a free-tier A1 will not.
SERVER_PORT_RANGE=24000-25000

# Tunnel back to the panel. Optional on Oracle: the instance has a routable public IP,
# so the panel can connect to DAEMON_PORT directly. Fill these in only if you would
# rather not expose the daemon port publicly, or the node sits on a private subnet.
# Leaving FRP_SERVER_ADDR blank disables the tunnel entirely.
FRP_SERVER_ADDR=
FRP_SERVER_PORT=7000
FRP_TOKEN=

# Port on the tunnel server that maps back to this node's API. Only meaningful with a
# tunnel configured above, and only needed when the panel cannot reach this node
# directly -- which on Oracle it can.
FRP_DAEMON_API_PORT=
