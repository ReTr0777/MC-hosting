<?xml version="1.0"?>
<Container version="2">
  <Name>CraftControl-FRP-Server</Name>
  <Repository>fatedier/frps:v0.58.0</Repository>
  <Registry>https://hub.docker.com/r/fatedier/frps</Registry>
  <Network>host</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/fatedier/frp</Support>
  <Project>https://github.com/fatedier/frp</Project>
  <Overview>Fast Reverse Proxy (FRP) Server for CraftControl. Tunnels Minecraft server ports from daemon nodes to this central server so players can connect.</Overview>
  <Category>Tools: Network:</Category>
  <WebUI/>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/fatedier/frp/dev/assets/frps/static/favicon.ico</Icon>
  <!--
    Host networking, deliberately.

    frps needs whole ranges - the game servers' tunnels and, above them, the node APIs of
    enrolled machines - and an Unraid template cannot express a range: a Port config maps
    one port each, so a "range start" and a "range end" entry publish exactly those two
    numbers and nothing between them. Every node allocated a port in the gap then gets a
    tunnel frps accepts, listens for inside its own namespace, and that nothing outside can
    dial. On host networking there is nothing to publish and nothing to keep in step.

    What still has to be right is the router, and only for the panel's own network:

      7000         forwarded, so nodes can dial in.
      24000-25000  forwarded only when the Velocity proxy is NOT deployed, which is the
                   case in an installation running just the panel, frps and nodes. Players
                   then connect straight to a server's own port. With the proxy running,
                   forward 25565 instead and leave this range internal - the proxy dials
                   the backend from this same host.
      25051-25100  never forwarded. These are node APIs, dialled only by the web panel from
                   this same host. Match this range to NODE_TUNNEL_PORT_RANGE on the panel.

    A node needs nothing open on its own network at all: frpc dials out to 7000.
  -->
  <ExtraParams/>
  <PostArgs>-c /etc/frp/frps.toml</PostArgs>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>

  <!--
    No Port configs: on host networking Unraid's port mappings do nothing. frps binds
    bindPort from frps.toml (7000) directly on the host.
  -->

  <!-- FRP Config File Mount -->
  <Config Name="FRP Config File" Target="/etc/frp/frps.toml" Default="/mnt/user/appdata/craftcontrol-frps/frps.toml" Mode="rw" Description="Path to your frps.toml configuration file on the host" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/craftcontrol-frps/frps.toml</Config>
</Container>
