# Copy this to .env (gitignored) and fill in real values.
# docker-compose.yml reads these automatically for the discord-bot and web services.

DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Optional: registers slash commands instantly to one guild instead of globally (up to 1hr propagation)
DISCORD_GUILD_ID=
# Shared secret between web and discord-bot. Any random string; must match on both.
DISCORD_BOT_SECRET=

# The address users reach the web panel on, e.g. https://retr0net.nl
# Verification and password-reset email links are built from this. Optional: when unset the
# panel derives it from the request, which covers direct access and a proxy that sets
# X-Forwarded-Host. Set it explicitly if those links come out wrong.
APP_URL=
