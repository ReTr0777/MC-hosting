datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

enum GlobalRole {
  GLOBAL_ADMIN
  USER
}

enum ServerRole {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

enum ServerStatus {
  OFFLINE
  STARTING
  RUNNING
  STOPPING
  INSTALLING
  ERROR
  /// Stopped to save resources, but the daemon still answers on its port and
  /// starts it again when a player tries to join.
  SLEEPING
}

enum ServerType {
  VANILLA
  FABRIC
  FORGE
  PAPER
  PURPUR
  MODRINTH
  CURSEFORGE
}

enum ExecutionMode {
  CONTAINER
  PROCESS
}

/// Which game a server runs. Its own axis rather than more `ServerType` members:
/// `ServerType` answers "which Minecraft flavour", and every value in it is
/// meaningless for anything that is not Minecraft.
///
/// Mirrored in `packages/shared/src/enums.ts`. `Node.enabledGames` deliberately
/// stays `String[]` rather than `Game[]` — it is written from what a daemon
/// reports over HTTP, and a daemon newer than the panel must not be able to
/// fail the write with an unknown enum value.
enum Game {
  MINECRAFT
  TERRARIA
}

model User {
  id              String             @id @default(uuid())
  email           String             @unique
  username        String             @unique
  passwordHash    String
  globalRole      GlobalRole         @default(USER)
  discordUserId   String?            @unique // Linked via /link in the Discord bot
  emailVerifiedAt DateTime?
  // Quotas apply only to servers this user OWNS (ServerPermission role OWNER). null = unlimited.
  // Ignored entirely for GLOBAL_ADMIN.
  maxServers      Int?
  maxMemoryMb     Int?
  maxCpu          Float?
  // Per-server ceilings: the largest single server this user may create. Independent of the
  // totals above — a user can have 24 GB total but no single server larger than 8 GB.
  maxServerMemoryMb Int?
  maxServerCpu      Float?
  // TOTP 2FA. totpSecret is encrypted at rest with the same scheme as other secrets
  // (see lib/crypto.ts) and is set as soon as setup begins, but totpEnabled only flips
  // true once the user proves they can generate a valid code — see /api/account/2fa/enable.
  totpSecret      String?
  totpEnabled     Boolean            @default(false)
  totpBackupCodes String[]           @default([]) // bcrypt-hashed, single use
  // Appearance, stored per account so a theme chosen on one device follows the user to
  // the next. localStorage is still written on every change and is what the pre-paint
  // script in layout.tsx reads — it cannot await a request — so these columns are the
  // sync layer, not the fast path.
  //
  // `customThemes` holds whole parsed theme files, which may carry embedded `data:` images.
  // Both the file (64 KB) and each image (512 KB) are already capped by parseThemeFile,
  // and the API caps the total again before it reaches this column.
  themeKey        String?
  customThemes    Json?
  // Suspension. A suspended user keeps every server and file, but cannot sign in and their
  // existing sessions stop working — see lib/suspension.ts. null = active.
  suspendedAt     DateTime?
  suspendedReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  permissions        ServerPermission[]
  auditLogs           AuditLog[]
  inviteCodes         InviteCode[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  apiKeys             ApiKey[]
  ownedNodes          Node[]               @relation("OwnedNodes")
  nodeEnrollments     NodeEnrollment[]

  @@map("users")
}

/// A personal access token letting a user authenticate scripts/CLIs against the panel
/// API without using their session cookie. Carries the same access as the owning user.
model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique // sha256 of the raw key; the raw key is only ever shown once at creation
  prefix     String              // first 8 chars of the raw key, shown in the UI for identification
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("api_keys")
}

/// Short-lived one-time token used to authorize a password reset via emailed link.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // sha256 of the raw token; the raw token is only ever in the emailed link
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Short-lived one-time token used to confirm a user controls their registered email.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Short-lived one-time code used to link a Discord account to a panel User via /link.
model DiscordLinkCode {
  id        String   @id @default(uuid())
  code      String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("discord_link_codes")
}

model Node {
  id              String   @id @default(uuid())
  name            String
  host            String   // IP address or FQDN of daemon
  port            Int      @default(3500)
  apiKey          String   // Encrypted/Hashed Bearer token used to authenticate calls to daemon
  isOnline        Boolean  @default(false)
  totalMemory     Int      // MB
  totalCpu        Int      // Cores / Percentage
  offloadPriority Int      @default(0) // Higher value = higher offload priority (e.g. Secondary PC = 10, Main Server = 1)
  // How far the sum of the servers' *allocated* RAM/CPU may exceed totalMemory/totalCpu.
  // 1.0 = never oversubscribe; 1.5 = allow 150% allocated. Minecraft servers rarely touch
  // their full -Xmx at once, so mild overcommit is normal — see lib/node-capacity.ts.
  overcommitRatio Float    @default(1.0)
  // CPU gets its own, far looser ratio because cpuLimit is a *ceiling* (Docker NanoCpus), not a
  // reservation: an idle server holds none of it, and PROCESS-mode servers are not capped at all.
  // Budgeting cores the way RAM is budgeted refuses servers a node is nowhere near saturating.
  cpuOvercommitRatio Float @default(4.0)

  // Games this node advertises, synced from the daemon on each ping. Defaults to
  // Minecraft-only so every existing node keeps behaving exactly as it does today,
  // and so a daemon too old to report the field never reads as "hosts nothing".
  enabledGames    String[] @default(["MINECRAFT"])

  // Set while the node is draining: it keeps running everything it already has, but the
  // scheduler stops placing new servers on it. Deliberately a timestamp rather than a
  // boolean so the panel can say how long a node has been held back — a node quietly
  // taking no work for a week is a fault, and "drained" alone would never reveal it.
  drainedAt       DateTime?

  // Live hardware stats (updated on each ping)
  liveCpuUsage    Float?   // Current CPU load percentage (0-100)
  liveRamUsed     Int?     // Currently used RAM in MB
  liveRamTotal    Int?     // Total RAM in MB (also updates totalMemory)
  liveDiskUsed    Float?   // Used disk on primary mount in GB
  liveDiskTotal   Float?   // Total disk on primary mount in GB
  liveCpuModel    String?  // CPU model string
  liveCpuCores    Int?     // Physical CPU cores
  liveOsDistro    String?  // OS distro e.g. "Ubuntu 22.04"
  liveCpuTemp     Float?   // CPU temperature in celsius (if available)
  // Newest Java the node can run. Null for a daemon too old to report it, which must
  // read as "unknown" rather than "none" — see javaSupportViolation in shared.
  liveJavaMajor   Int?
  // Free space on the filesystem holding the daemon's data directory, in MB. Distinct
  // from liveDiskTotal, which describes the largest mount and may be another disk.
  liveDataDiskFreeMb Int?
  // Daemon package version as of the last successful ping. Null for a daemon too old to
  // report one, which is itself a signal — see daemonVersionState in shared.
  liveDaemonVersion String?
  liveLastSeenAt  DateTime? // Last time a successful hardware check was received

  // Who this machine belongs to. Null is the normal case and means the node is part of
  // the hosting fleet: everybody can see it and the scheduler may place anything on it.
  // Set when a customer enrolled their own machine (see NodeEnrollment), which makes the
  // node private — only the owner and a global admin can see it, place servers on it or
  // migrate onto it. Ownership is deliberately not a permission table: a node has exactly
  // one hoster, and sharing someone's home PC with strangers is not a feature.
  // Where this machine said it could be found when it enrolled, and the port its daemon
  // listens on locally. Kept so the panel can look for the node again later without a new
  // setup code: the address a node is registered at goes stale for ordinary reasons — DHCP
  // moves it, a firewall that was blocking the probe has since been opened, a laptop
  // changes network — and without this the only recovery was to delete it and start over.
  candidateAddresses String[] @default([])
  candidatePort      Int?

  ownerId         String?
  // SetNull rather than Cascade: deleting an account must not silently take a machine's
  // servers with it. The node falls back to the shared pool for an admin to deal with.
  owner           User?    @relation("OwnedNodes", fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  servers         Server[]
  hostingPool     ServerHostingPoolMember[]
  enrollments     NodeEnrollment[]

  @@index([ownerId])
  @@map("nodes")
}

/// A one-time code that lets a machine register itself as a node.
///
/// Self-hosting used to need a global admin: invent a key, create the node by hand, export
/// the config file, send it over. This is the same handshake with the direction reversed —
/// the user asks the panel for a code, types it into the desktop app, and the machine
/// registers itself with a key it generated and never had to transmit by hand.
///
/// The code is stored hashed for the same reason an API key is: the row is a credential
/// until it is claimed, and a leaked database should not hand out nodes.
model NodeEnrollment {
  id         String    @id @default(uuid())
  // sha256 of the code shown to the user; the raw code exists only in that one response.
  codeHash   String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // What the node should be called once it enrolls. The machine's own hostname is used
  // when this is blank, which is usually the more recognisable of the two anyway.
  name       String?
  expiresAt  DateTime
  // Set the moment a machine redeems it. Single use: a code that has enrolled one node
  // must not enroll a second, or one leaked code becomes an open door onto the panel.
  claimedAt  DateTime?
  nodeId     String?
  node       Node?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("node_enrollments")
}

/// One machine's turn at hosting a server.
///
/// The current host is already Server.nodeId; what this adds is every host before it,
/// which is the question that matters once worlds live on customers' own PCs rather
/// than on the fleet. "Whose machine was this world on last week" has no other answer:
/// nodeId only ever holds the latest one.
///
/// Denormalised on purpose. A node somebody enrolled is deleted the day they leave, and
/// their account can go with it — but "hosted on a machine that no longer exists" is
/// precisely the row being looked for, so the names are copied in rather than joined to.
/// nodeId is kept alongside them for as long as it resolves, and is allowed to dangle.
model ServerHostingEvent {
  id            String    @id @default(uuid())
  serverId      String
  server        Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)

  /// The node as it was, not as it is. Null owner means a fleet node rather than
  /// somebody's own machine — the distinction the panel draws everywhere else.
  nodeId        String?
  nodeName      String
  ownerName     String?

  /// Open-ended while this machine still has it. Exactly one row per server should have
  /// a null endedAt, and it should agree with Server.nodeId.
  startedAt     DateTime  @default(now())
  endedAt       DateTime?

  /// Who moved it here. Null for the turn opened when the server was first created.
  movedByUserId String?

  @@index([serverId, startedAt])
  @@map("server_hosting_events")
}

/// A machine its owner has volunteered to host one particular server on.
///
/// Migration destinations are normally limited to nodes the mover could have created the
/// server on: the shared fleet, and their own machines. That rule exists so nobody can
/// drop a forty-gigabyte modpack onto a friend's SSD unasked, and it is the reason a
/// group of friends could not pass a world between their PCs.
///
/// This is the exception, and it is granted by the person who owns the hardware rather
/// than by whoever wants to move the server. Opting in once says "this world may live on
/// my machine"; after that the server's admins move it freely between pooled machines,
/// which is what makes juggling it bearable. Opting out again only removes the
/// permission - a server already running there is not evicted by it.
model ServerHostingPoolMember {
  id        String   @id @default(uuid())
  serverId  String
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  nodeId    String
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  /// Whoever opted the machine in. Kept so the panel can say who volunteered it, and so
  /// a permission granted by an admin on someone's behalf is distinguishable later.
  addedById String?
  createdAt DateTime @default(now())

  @@unique([serverId, nodeId])
  @@index([nodeId])
  @@map("server_hosting_pool")
}

model Server {
  id                String             @id @default(uuid())
  uuid              String             @unique @default(uuid())
  name              String
  description       String?
  nodeId            String
  node              Node               @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  containerId       String?            // Docker container ID on daemon node
  executionMode     ExecutionMode      @default(PROCESS)
  status            ServerStatus       @default(OFFLINE)

  // Which game this runs. Defaults to MINECRAFT so every existing row is correct
  // without a backfill, and so any writer that doesn't set it still means Minecraft.
  game              Game               @default(MINECRAFT)
  // Per-game settings whose shape is decided by `game` — see TerrariaConfig in
  // packages/shared. Null for Minecraft, which uses serverType/mcVersion instead.
  gameConfig        Json?

  // Game Configuration
  // serverType and mcVersion are Minecraft-only and are ignored when game != MINECRAFT.
  // Renaming them to gameVersion/variant would touch every Minecraft call site for no
  // functional gain, so they keep their names — see plan.md §5.
  serverType        ServerType         @default(FABRIC)
  mcVersion         String             @default("1.20.1")
  serverPort        Int                @default(25565)
  modpackSlug       String?            // Modrinth modpack slug/project_id (used when serverType == MODRINTH)
  eulaAccepted      Boolean            @default(false) // User must check EULA box in Web Panel before container launch
  
  // Resource Limits
  memoryMb          Int                @default(2048)
  cpuLimit          Float              @default(1.0) // CPU cores limit

  // Domain & Proxy Routing
  subdomain         String?            // e.g. "survival"
  domain            String?            // e.g. "yourdomain.com"

  // BlueMap live world map
  bluemapPort       Int?               // Host port published to the container's 8100
  bluemapEnabled    Boolean            @default(false)

  // Sleep on empty / wake on join
  sleepEnabled      Boolean            @default(false)
  sleepAfterMinutes Int                @default(15)  // Idle minutes before sleeping
  sleepEmptySince   DateTime?          // First tick that saw zero players; cleared when someone joins
  lastSleptAt       DateTime?
  lastWokeAt        DateTime?

  // Suspension. A suspended server cannot be started, woken or scheduled, but keeps its
  // world and files. Independent of the owner's suspension — either one blocks a start.
  suspendedAt       DateTime?
  suspendedReason   String?

  // Backup retention. null on a field means that rule doesn't apply. All three are evaluated
  // together and the union of what they condemn is deleted — see lib/backup-retention.ts.
  backupRetentionCount Int?           // Keep at most N backups
  backupRetentionDays  Int?           // Delete backups older than N days
  backupMaxTotalMb     Int?           // Delete oldest until the set fits in N MB

  // Whether this server's backups are copied to the node's off-site storage, and only
  // meaningful on a node that has such storage configured. Granted by the host: the API
  // restricts changes to GLOBAL_ADMIN, since off-site storage is the operator's to pay for.
  //
  // Defaults true so `prisma db push` leaves every existing row doing exactly what it does
  // today — they were all being uploaded — while the create path sets it to false outright,
  // so a new server is local-only until it is granted. The default is therefore about
  // existing rows, not about new ones.
  offsiteBackups       Boolean         @default(true)

  // Crash auto-restart
  autoRestartEnabled   Boolean         @default(false)
  crashCount           Int             @default(0)    // Crashes seen within the current crashWindowStartedAt window
  crashWindowStartedAt DateTime?       // Start of the current 30-minute crash-loop detection window
  lastCrashAt          DateTime?       // Used to compute exponential backoff before the next restart attempt

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  permissions       ServerPermission[]
  schedules         ServerSchedule[]
  mapShares         MapShare[]
  statSamples       ServerStatSample[]
  players           ServerPlayer[]
  playerSessions    PlayerSession[]
  hostingEvents     ServerHostingEvent[]
  hostingPool       ServerHostingPoolMember[]

  @@map("servers")
}

/// A Minecraft account seen on one server, with its running totals.
///
/// Scoped per server rather than globally: the same username on two servers is two different
/// players as far as playtime and first-join are concerned, and an offline-mode server's names
/// aren't guaranteed to be the same accounts as an online-mode one's.
model ServerPlayer {
  id             String    @id @default(uuid())
  serverId       String
  server         Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  username       String
  /// Mojang UUID, read from the server's own login line. Null on offline-mode servers.
  uuid           String?
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  /// Total across all completed sessions. The session currently open is added on read.
  playtimeSeconds Int      @default(0)
  sessionCount   Int       @default(0)

  sessions       PlayerSession[]

  @@unique([serverId, username])
  @@index([serverId, lastSeenAt])
  @@map("server_players")
}

/// One completed visit. Open sessions live in the daemon and are never written here.
model PlayerSession {
  id        String       @id @default(uuid())
  playerId  String
  player    ServerPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  serverId  String
  server    Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  joinedAt  DateTime
  leftAt    DateTime
  seconds   Int

  @@index([playerId, joinedAt])
  @@index([serverId, joinedAt])
  @@map("player_sessions")
}

/// One CPU/RAM/player-count reading per running server per monitor tick, for trend graphs.
model ServerStatSample {
  id          String   @id @default(uuid())
  serverId    String
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  cpuPercent  Float
  memoryMb    Int
  playerCount Int?
  createdAt   DateTime @default(now())

  @@index([serverId, createdAt])
  @@map("server_stat_samples")
}

/// A public, revocable link that grants access to one server's BlueMap and nothing else.
model MapShare {
  id           String    @id @default(uuid())
  token        String    @unique
  serverId     String
  server       Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  label        String?
  enabled      Boolean   @default(true)
  expiresAt    DateTime?
  passwordHash String?   // scrypt hash; null = no password required
  createdBy    String?   // email of the admin who minted it
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([token])
  @@map("map_shares")
}

model ServerSchedule {
  id             String    @id @default(uuid())
  serverId       String
  server         Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name           String
  cronExpression String    // e.g. "0 */6 * * *" or "0 0 * * *"
  actionType     String    // "BACKUP" | "COMMAND" | "START" | "RESTART" | "STOP"
  payload        String?   // Console command string if actionType === "COMMAND"
  isEnabled      Boolean   @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("server_schedules")
}

model ServerPermission {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverId  String
  server    Server     @relation(fields: [serverId], references: [id], onDelete: Cascade)
  role      ServerRole @default(VIEWER)
  createdAt DateTime   @default(now())

  @@unique([userId, serverId])
  @@map("server_permissions")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // e.g., "SERVER_START", "MODPACK_INSTALL", "EULA_ACCEPT"
  details   String?  // JSON stringified details
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model InviteCode {
  id        String   @id @default(uuid())
  code      String   @unique
  uses      Int      @default(0)
  maxUses   Int?
  createdBy String?
  creator   User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invite_codes")
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model CloudflareLog {
  id          String   @id @default(uuid())
  action      String   // e.g. "PROVISION_SRV", "DELETE_SRV"
  subdomain   String
  domain      String
  status      String   // "SUCCESS" | "FAILED"
  details     String
  userEmail   String?
  createdAt   DateTime @default(now())

  @@map("cloudflare_logs")
}

/// An outbound alert destination (Discord webhook or generic JSON endpoint).
model NotificationChannel {
  id         String   @id @default(uuid())
  name       String
  type       String   @default("DISCORD") // "DISCORD" | "GENERIC"
  url        String
  enabled    Boolean  @default(true)
  events     String[] @default([]) // Subscribed event types; empty = every event
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  deliveries NotificationDelivery[]

  @@map("notification_channels")
}

/// Delivery history, so a silent webhook can be diagnosed from the panel.
model NotificationDelivery {
  id        String   @id @default(uuid())
  channelId String?
  channel   NotificationChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  eventType String
  severity  String   @default("info") // "info" | "warning" | "critical"
  title     String
  body      String
  status    String   // "SUCCESS" | "FAILED"
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("notification_deliveries")
}
