DATABASE_URL="postgresql://mcuser:mcpassword@localhost:5432/mcmanager?schema=public"
JWT_SECRET="super-secret-jwt-token-key-change-in-production"

# Encrypts secrets at rest (currently the Cloudflare API token in System Settings).
# Set this once and never change it: rotating it makes every stored secret
# undecryptable and they must be re-entered in the panel.
# If unset, falls back to JWT_SECRET — which means rotating JWT_SECRET breaks them.
SECRET_ENCRYPTION_KEY="change-me-to-a-long-random-string-and-keep-it-stable"
