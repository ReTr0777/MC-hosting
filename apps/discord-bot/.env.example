DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Optional. Commands are always registered globally, which is what lets the bot be installed
# to an account and used anywhere; setting this additionally registers them to one guild so
# changes show up there immediately instead of after up to an hour.
DISCORD_GUILD_ID=
# Base URL of the CraftControl web panel, reachable from wherever this bot runs
WEB_API_URL=http://localhost:3000
# Must match DISCORD_BOT_SECRET in the web panel's environment
DISCORD_BOT_SECRET=
